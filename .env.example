# Falcon Backend Configuration
#
# Copy this file to .env and fill in your actual values.

# ==================== DATABASE ====================
# PostgreSQL connection string
DATABASE_URL=postgresql://localhost:5432/falcon

# Connection pool settings
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=10

# ==================== LLM CONFIGURATION ====================
# Choose your LLM provider: "ollama" (free, local) or "openai" (paid, cloud)
LLM_PROVIDER=ollama

# ============ OLLAMA (Local LLM - Free) ============
# Ollama server URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use (options: mistral:7b-instruct, codellama:13b-instruct, llama3.2:3b)
OLLAMA_MODEL=mistral:7b-instruct

# ============ OPENAI (Cloud LLM - Paid) ============
# Your OpenAI API key (required when LLM_PROVIDER=openai)
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ==================== SECURITY ====================
# API key for authentication (optional in development)
# Generate a secure random key: openssl rand -hex 32
API_KEY=your-secret-api-key-here

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==================== APPLICATION ====================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Environment: development or production
ENVIRONMENT=development

# ==================== INGESTION ====================
# Maximum file size to index (in bytes)
# Default: 512000 (500KB)
MAX_FILE_SIZE=512000
